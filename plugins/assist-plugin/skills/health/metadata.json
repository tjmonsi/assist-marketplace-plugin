{
  "name": "health",
  "description": "Check assist-plugin hook health: Node version, guard, injection-filter, prose-hook, and FSA-hook self-tests, recent hook failures, subagent reports with terminal-block problems, disabled guards, Claude Code attribution settings.",
  "effort": "low",
  "allowed-tools": [
    "Bash(node \"${CLAUDE_PLUGIN_ROOT}/hooks/health-check.js\" --data-dir \"${CLAUDE_PLUGIN_DATA}\")",
    "Bash(node \"${CLAUDE_PLUGIN_ROOT}/hooks/health-check.js\" --data-dir \"${CLAUDE_PLUGIN_DATA}\" --clear)",
    "Bash(node \"${CLAUDE_PLUGIN_ROOT}/hooks/health-check.js\" --data-dir \"${CLAUDE_PLUGIN_DATA}\" --verify-audit)",
    "Bash(node \"${CLAUDE_PLUGIN_ROOT}/hooks/health-check.js\" --data-dir \"${CLAUDE_PLUGIN_DATA}\" --export-evidence --from * --to *)",
    "Read"
  ],
  "argument-hint": "[--clear | --verify-audit | --export-evidence --from YYYY-MM-DD --to YYYY-MM-DD]"
}
